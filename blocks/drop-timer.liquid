{%- doc -%}
  Renders a live countdown timer to a configurable target release date.
  Used in the drop-countdown section.
{%- enddoc -%}

<div class="drop-timer-block" style="margin-bottom: 24px;">
  {% if block.settings.release_date != blank %}
    <p
      style="
        font-size: 0.75rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: #555555;
        margin: 0 0 12px;
      "
    >
      Dropping
    </p>
    <p
      style="
        font-size: 1.4rem;
        font-weight: bold;
        letter-spacing: 0.08em;
        margin: 0 0 16px;
      "
    >
      {{ block.settings.release_date }}
    </p>
  {% endif %}

  <div
    class="drop-timer__display"
    id="drop-timer-{{ block.id }}"
    data-release="{{ block.settings.release_date }}"
    style="
      display: flex;
      justify-content: center;
      gap: 16px;
    "
  >
    <div style="text-align: center;">
      <span
        class="timer-days"
        style="display: block; font-size: 2rem; font-weight: bold; line-height: 1; min-width: 60px;"
        >--</span
      >
      <span style="font-size: 0.65rem; letter-spacing: 0.12em; color: #888;">DAYS</span>
    </div>
    <div style="text-align: center;">
      <span
        class="timer-hrs"
        style="display: block; font-size: 2rem; font-weight: bold; line-height: 1; min-width: 60px;"
        >--</span
      >
      <span style="font-size: 0.65rem; letter-spacing: 0.12em; color: #888;">HRS</span>
    </div>
    <div style="text-align: center;">
      <span
        class="timer-mins"
        style="display: block; font-size: 2rem; font-weight: bold; line-height: 1; min-width: 60px;"
        >--</span
      >
      <span style="font-size: 0.65rem; letter-spacing: 0.12em; color: #888;">MINS</span>
    </div>
    <div style="text-align: center;">
      <span
        class="timer-secs"
        style="display: block; font-size: 2rem; font-weight: bold; line-height: 1; min-width: 60px;"
        >--</span
      >
      <span style="font-size: 0.65rem; letter-spacing: 0.12em; color: #888;">SECS</span>
    </div>
  </div>
</div>

<script>
  (function () {
    var container = document.getElementById('drop-timer-{{ block.id }}');
    var releaseDate = new Date(container.dataset.release);

    if (isNaN(releaseDate)) return;

    function pad(n) {
      return n < 10 ? '0' + n : n;
    }

    function tick() {
      var now = new Date();
      var diff = releaseDate - now;

      if (diff <= 0) {
        container.querySelector('.timer-days').textContent = '00';
        container.querySelector('.timer-hrs').textContent = '00';
        container.querySelector('.timer-mins').textContent = '00';
        container.querySelector('.timer-secs').textContent = '00';
        return;
      }

      var days = Math.floor(diff / (1000 * 60 * 60 * 24));
      var hrs = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      var mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      var secs = Math.floor((diff % (1000 * 60)) / 1000);

      container.querySelector('.timer-days').textContent = pad(days);
      container.querySelector('.timer-hrs').textContent = pad(hrs);
      container.querySelector('.timer-mins').textContent = pad(mins);
      container.querySelector('.timer-secs').textContent = pad(secs);

      setTimeout(tick, 1000);
    }

    tick();
  })();
</script>

{% schema %}
{
  "name": "Drop Timer",
  "settings": [
    {
      "type": "text",
      "id": "release_date",
      "label": "Release date",
      "info": "Use a format like: November 28, 2026 10:00:00",
      "default": "November 28, 2026 10:00:00"
    }
  ],
  "presets": [
    {
      "name": "Drop Timer",
      "category": "Drop"
    }
  ]
}
{% endschema %}
