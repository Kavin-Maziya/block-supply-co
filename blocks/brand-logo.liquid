{%- doc -%}
  Displays a brand logo image with a link to their collection.
  Used in the brand-showcase section.
{%- enddoc -%}

<div
  class="brand-logo-block"
  style="
    text-align: center;
    padding: 12px;
  "
>
  {% if block.settings.logo != blank %}
    <a href="{{ block.settings.link_url }}">
      <img
        src="{{ block.settings.logo | image_url: width: block.settings.logo_size }}"
        alt="{{ block.settings.brand_name }}"
        width="{{ block.settings.logo_size }}"
        height="auto"
        style="--logo-size: {{ block.settings.logo_size }}px; width: var(--logo-size); height: auto; object-fit: contain;"
        loading="lazy"
      >
    </a>
  {% else %}
    <a href="{{ block.settings.link_url }}" style="font-weight: bold; font-size: 1.2rem;">
      {{ block.settings.brand_name }}
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "Brand Logo",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Brand Name"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Brand logo"
    },
    {
      "type": "range",
      "id": "logo_size",
      "label": "Logo width",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Collection link"
    }
  ],
  "presets": [
    {
      "name": "Brand Logo",
      "category": "Brand"
    }
  ]
}
{% endschema %}
