{%- doc -%}
  A configurable heading block for the brand showcase section.
  Can be reused in other sections that accept theme blocks.
{%- enddoc -%}

<div
  class="brand-heading-block"
  style="
    text-align: {{ block.settings.alignment }};
    padding: 12px 0;
    grid-column: 1 / -1;
  "
>
  <h2
    style="
      font-size: 1.8rem;
      letter-spacing: 0.06em;
      margin: 0;
      text-transform: uppercase;
    "
  >
    {{ block.settings.heading }}
  </h2>

  {% if block.settings.subheading != blank %}
    <p style="color: #888; font-size: 0.9rem; margin: 8px 0 0;">
      {{ block.settings.subheading }}
    </p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Brand Heading",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Brands"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "The brands we stock at Block Supply Co."
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Brand Heading",
      "category": "Brand"
    }
  ]
}
{% endschema %}
